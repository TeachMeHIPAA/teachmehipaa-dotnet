{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "../../src/TeachMeHipaa",
          "files": [
            "TeachMeHipaa.csproj"
          ]
        }
      ],
      "output": "api",
      "properties": {
        "TargetFramework": "net8.0"
      },
      "namespaceLayout": "flattened",
      "memberLayout": "samePage"
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "api/**.yml",
          "api/index.md"
        ]
      },
      {
        "files": [
          "index.md",
          "toc.yml"
        ]
      },
      {
        "src": "../articles",
        "files": [
          "*.md",
          "toc.yml"
        ],
        "dest": "articles"
      },
      {
        "src": "../reference",
        "files": [
          "resources.md"
        ],
        "dest": "reference"
      }
    ],
    "output": "_site",
    "template": [
      "default",
      "modern"
    ],
    "globalMetadata": {
      "_appName": "TeachMeHIPAA .NET",
      "_appTitle": "TeachMeHIPAA .NET API reference",
      "_appFooter": "TeachMeHIPAA .NET library, MIT License",
      "_enableSearch": true,
      "_disableContribution": true
    }
  }
}
