<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Writes the generated service and model layer of src/TeachMeHipaa from
    openapi/sdk-ir.json. A build tool only: never packed or shipped.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <RootNamespace>TeachMeHipaa.Generator</RootNamespace>
    <AssemblyName>TeachMeHipaa.Generator</AssemblyName>
    <IsPackable>false</IsPackable>
    <!-- Needed for IDE0005 (unused usings) on build; the tool carries no XML docs. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="JsonSchema.Net" Version="7.3.0" />
  </ItemGroup>

</Project>
